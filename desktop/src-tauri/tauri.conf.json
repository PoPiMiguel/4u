{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4u",
  "version": "0.1.0",
  "identifier": "app.fouru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "4u",
        "url": "index.html",
        "width": 440,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      },
      {
        "label": "widget",
        "title": "4u widget",
        "url": "widget.html",
        "width": 170,
        "height": 170,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/4u/**", "$VIDEO/4u/**", "$APPDATA/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
